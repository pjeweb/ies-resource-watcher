#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Runs the watcher inside an installed Atoolo application without modifying
 * it. The application's vendor directory, .env and configuration are used;
 * the watcher bundle is added in memory, and the compiled container is kept
 * below the watcher state directory.
 *
 * Usage: ies-resource-watcher <config.json> <command> [options]
 * See resources/attached.example.json.
 */

use StadtBraunschweig\IesResourceWatcher\Attached\AttachedKernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Dotenv\Dotenv;

$arguments = $_SERVER['argv'];
$configFile = isset($arguments[1]) ? realpath($arguments[1]) : false;
if ($configFile === false || !is_file($configFile)) {
    fwrite(STDERR, "usage: ies-resource-watcher <config.json> <command> [options]\n");
    exit(2);
}
if (function_exists('posix_geteuid') && posix_geteuid() === 0) {
    // Root would leave root-owned caches and state behind for the service user.
    fwrite(STDERR, "ies-resource-watcher: run as the user of the native indexer, not as root\n");
    exit(2);
}
$config = json_decode((string) file_get_contents($configFile), true, 64, JSON_THROW_ON_ERROR);
$project = realpath((string) ($config['project'] ?? ''));
if ($project === false || !is_file($project . '/vendor/autoload.php')) {
    fwrite(STDERR, "ies-resource-watcher: project is not an installed application: " . ($config['project'] ?? '') . "\n");
    exit(2);
}
if (isset($config['resource_root'])) {
    putenv('RESOURCE_ROOT=' . $config['resource_root']);
    $_SERVER['RESOURCE_ROOT'] = $_ENV['RESOURCE_ROOT'] = $config['resource_root'];
}

// The host's dependencies only; this package contributes its own classes.
require $project . '/vendor/autoload.php';
$source = dirname(__DIR__) . '/src';
spl_autoload_register(static function (string $class) use ($source): void {
    $prefix = 'StadtBraunschweig\\IesResourceWatcher\\';
    if (str_starts_with($class, $prefix)) {
        $file = $source . '/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
        if (is_file($file)) {
            require $file;
        }
    }
});

$watcher = $config['watcher'] ?? [];
$command = array_slice($arguments, 2);
if (($command[0] ?? null) === 'ies-resource-watcher:status') {
    // The health check reads the status file only; it must work even if the application does not boot.
    $application = new Symfony\Component\Console\Application('ies-resource-watcher');
    $application->add(new StadtBraunschweig\IesResourceWatcher\Command\StatusCommand(
        StadtBraunschweig\IesResourceWatcher\Watcher\WatcherConfig::fromArray($watcher),
    ));
    exit($application->run(new ArgvInput([$arguments[0], ...$command])));
}

(new Dotenv())->bootEnv($project . '/.env');

$environment = (string) ($config['environment'] ?? $_SERVER['APP_ENV'] ?? 'prod');
$watcher['console'] ??= [PHP_BINARY, __FILE__, $configFile];
$watcher['restart_on_change'] = array_values(array_unique([...($watcher['restart_on_change'] ?? []), $config['project']]));
$watcher['atoolo_search']['native_cache_dir'] ??= (new App\Kernel($environment, false))->getCacheDir();

$kernel = new AttachedKernel($project, $watcher, AttachedKernel::fingerprint($project, $environment, $watcher, $source), $environment);
exit((new Application($kernel))->run(new ArgvInput([$arguments[0], ...$command])));
